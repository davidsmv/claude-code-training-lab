{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or '.', '.claude/hooks/block_prod_config.py'), run_name='__main__')\"; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CLAUDE_PROJECT_DIR') or '.', '.claude/hooks/log_edit.py'), run_name='__main__')\"; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
